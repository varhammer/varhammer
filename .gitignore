# .gitignore — varhammer 1.1.5 "Midnight"
# Exclude build artifacts and temporary files from version control.
# Sources only: distribution binaries hosted in GitHub Releases.

# --- Binary builds (do not commit) ---
*.zip
*.exe
*.dll
*.so
*.dylib
*.msi

# Build artifacts - DO NOT commit
varhammer/
tmp_download/
emacs-source/
sbcl-source/
slime-source/
quicklisp-source/
local-projects-source/
sbcl-config/
root-metadata/

# Temporary files
*.tmp
*.log
Thumbs.db

# Distribution archive (hosted in Releases)
varhammer-portable.zip
